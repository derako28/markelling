{
  "mcpServers": {
    "tf-db": {
      "command": "node",
      "args": ["${TF_REPO}/mcp-server/dist/index.js"],
      "env": {
        "MONGODB_URI": "${TF_MONGODB_URI:-mongodb://127.0.0.1:27017/twitter-factory}",
        "TF_OWN_ACCOUNT": "markelling_",
        "TF_TZ": "Europe/Warsaw"
      }
    },
    "tf-api": {
      "command": "node",
      "args": ["${TF_REPO}/backend/mcp/server.js"],
      "env": {
        "TF_API_URL": "${TF_API_URL:-http://127.0.0.1:3001}",
        "ADMIN_TOKEN": "${TF_ADMIN_TOKEN}",
        "TF_WORKSPACE": "finance",
        "TF_OWN_ACCOUNT": "markelling_"
      }
    }
  }
}
